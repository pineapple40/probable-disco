# Copy this file to .env and adjust values as needed.
# Nothing in this file is a secret. Do not commit your real .env file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ENV=development

# ---------------------------------------------------------------------------
# Database (docker-compose Postgres by default)
# ---------------------------------------------------------------------------
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_dev_password
POSTGRES_DB=probable_disco
POSTGRES_PORT=5432
DATABASE_URL="postgresql://trader:trader_dev_password@localhost:5432/probable_disco?schema=public"

# ---------------------------------------------------------------------------
# Redis (docker-compose Redis by default) - caching, rate limiting, jobs
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-change-me-please-1234567890"
# Generate with: openssl rand -base64 32 (used to encrypt broker credentials at rest)
CREDENTIALS_ENCRYPTION_KEY="dev-only-insecure-32-byte-key-change-me"
SESSION_TTL_HOURS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Live trading is disabled by default and cannot be enabled by client action.
# Flipping this to "true" only unlocks the server-side acknowledgement flow;
# it does not by itself connect to a real broker.
FEATURE_LIVE_TRADING_ENABLED=false
FEATURE_MFA_ENABLED=true
FEATURE_SIGNUP_ENABLED=true

# ---------------------------------------------------------------------------
# Market data provider
# ---------------------------------------------------------------------------
# "simulated" is the only implemented provider today. Real providers
# (e.g. a licensed real-time/delayed feed) can be added later via the
# MarketDataProvider adapter interface in src/server/market-data.
MARKET_DATA_PROVIDER=simulated

# ---------------------------------------------------------------------------
# Broker provider
# ---------------------------------------------------------------------------
# "simulated" is a fully self-contained paper broker requiring no external
# account. An "alpaca" adapter placeholder exists for later use once you
# add real (paper) API credentials - it is NOT required to run the app.
BROKER_PROVIDER=simulated
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------------------------
# Outbound notifications (optional - all unset = in-app notifications only)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Probable Disco <no-reply@example.com>"

SMS_PROVIDER=
SMS_API_KEY=

PUSH_PROVIDER=
PUSH_API_KEY=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
ERROR_REPORTING_DSN=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Number of trusted reverse proxy hops in front of this app (nginx, a load
# balancer, etc). 0 (default) means the app is directly reachable, so the
# client-controllable X-Forwarded-For header is ignored for rate limiting and
# audit logging. Only raise this if you control every hop between the
# internet and this app and know they overwrite/append to the header rather
# than passing through whatever the client sent.
TRUSTED_PROXY_COUNT=0

# Comma-separated list of extra origins (hostnames, no scheme/port) allowed
# to reach the Next.js dev server's internal assets - e.g. if you're
# developing on a VM/phone and load the app via its LAN IP instead of
# localhost. Leave unset if you only ever use localhost. Dev-mode only, has
# no effect in production.
# NEXT_DEV_ALLOWED_ORIGINS=10.0.1.23
